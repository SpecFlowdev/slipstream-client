<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose paints everything; this only has to keep the window from
         flashing a colour the app never uses. -->
    <style name="Theme.Slipstream" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/window</item>
    </style>
</resources>
