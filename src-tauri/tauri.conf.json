{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Slipstream",
  "version": "0.1.4",
  "identifier": "cc.slipstream.client",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Slipstream",
        "width": 1020,
        "height": 680,
        "minWidth": 860,
        "minHeight": 560,
        "resizable": true,
        "center": true,
        "theme": null
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPCONFIG/*"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "appimage", "nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/slipstream-tunnel"],
    "category": "Utility",
    "shortDescription": "DNS tunnel client",
    "longDescription": "Client for the slipstream DNS tunnel: manages server profiles and exposes the tunnel as a local SOCKS5 proxy.",
    "linux": {
      "deb": {
        "depends": []
      }
    }
  }
}
